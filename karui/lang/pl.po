msgstr "Pobierz diagnostykę galerii"

msgid "The plugin is temporarily unavailable."
msgstr "Wtyczka jest chwilowo niedostępna."
msgid "This part of the page is temporarily unavailable. The rest of the site is working normally."
msgstr "Ta część strony jest chwilowo niedostępna. Pozostała część witryny działa normalnie."
msgid "Sign in again."
msgstr "Zaloguj się ponownie."
msgid "Invalid form token. Refresh the page."
msgstr "Nieprawidłowy token formularza. Odśwież stronę."
msgid "Request origin is not allowed."
msgstr "Niedozwolone źródło żądania."
msgid "Invalid form data."
msgstr "Nieprawidłowe dane formularza."
msgid "The file is too large (maximum 10 MB)."
msgstr "Plik jest zbyt duży (maksymalnie 10 MB)."
msgid "The operation could not be completed."
msgstr "Nie udało się wykonać operacji."
msgid "File not found."
msgstr "Nie znaleziono pliku."
msgid "Plugin not found."
msgstr "Nie znaleziono wtyczki."
msgid "Plugin file not found."
msgstr "Nie znaleziono pliku wtyczki."
msgid "The plugin is not assigned to this page."
msgstr "Wtyczka nie jest przypisana do tej strony."
msgid "The session has expired."
msgstr "Sesja wygasła."
msgid "The session has expired. Sign in again."
msgstr "Sesja wygasła. Zaloguj się ponownie."
msgid "The plugin does not provide an administration view."
msgstr "Wtyczka nie udostępnia widoku administracyjnego."
msgid "The plugin is temporarily unavailable. The panel is still working."
msgstr "Wtyczka jest chwilowo niedostępna. Panel nadal działa."
msgid "plugin.json could not be read."
msgstr "Nie udało się odczytać plugin.json."
msgid "The selected theme could not be prepared."
msgstr "Nie udało się przygotować wybranego motywu."
msgid "Choose an image."
msgstr "Wybierz obraz."
msgid "Language codes cannot be repeated."
msgstr "Kody języków nie mogą się powtarzać."
msgid "The available language list must include the default language."
msgstr "Lista dostępnych języków musi zawierać język domyślny."
msgid "Page metadata is missing."
msgstr "Brak metadanych strony."
msgid "This language is not available for the site."
msgstr "Ten język nie jest dostępny dla strony."
msgid "Page not found."
msgstr "Nie znaleziono strony."
msgid "The requested language version was not found."
msgstr "Nie znaleziono wybranej wersji językowej strony."
msgid "The same subpage occurs more than once in the list."
msgstr "Lista zawiera tę samą podstronę więcej niż raz."
msgid "The list contains a page outside the selected section."
msgstr "Lista zawiera stronę spoza wybranej sekcji."
msgid "A page already exists at this address."
msgstr "Strona pod tym adresem już istnieje."
msgid "Parent page not found."
msgstr "Nie znaleziono strony nadrzędnej."
msgid "Remove links to this page from the menu and home page settings first."
msgstr "Najpierw usuń odnośniki do strony z menu i ustawień strony głównej."
msgid "Remove the subpages first. They are not deleted automatically."
msgstr "Najpierw usuń podstrony. Nie są usuwane automatycznie."
msgid "Settings changed after opening the form. Refresh the page before saving."
msgstr "Ustawienia zmieniły się po otwarciu formularza. Odśwież stronę przed zapisem."
msgid "The home page must be a published page."
msgstr "Strona startowa musi być opublikowaną stroną."
msgid "Invalid theme."
msgstr "Nieprawidłowy motyw."
msgid "The menu may contain at most 200 items."
msgstr "Menu może zawierać maksymalnie 200 elementów."
msgid "The menu points to a page that does not exist."
msgstr "Menu wskazuje na nieistniejącą stronę."
msgid "A gallery may contain at most 500 photos."
msgstr "Galeria może zawierać maksymalnie 500 zdjęć."
msgid "Invalid image."
msgstr "Nieprawidłowy obraz."
msgid "Allowed image formats are JPEG, PNG, WebP, GIF and AVIF."
msgstr "Dozwolone formaty obrazów to JPEG, PNG, WebP, GIF i AVIF."
msgid "Photo not found."
msgstr "Nie znaleziono zdjęcia."
msgid "Unknown plugin."
msgstr "Nieznana wtyczka."
msgid "This address is reserved by the engine."
msgstr "Ten adres jest zarezerwowany przez silnik."
msgid "Invalid path."
msgstr "Nieprawidłowa ścieżka."
msgid "The path is outside the content directory."
msgstr "Ścieżka znajduje się poza katalogiem treści."
msgid "Symbolic links are not supported."
msgstr "Dowązania symboliczne nie są obsługiwane."
msgid "The file changed after opening the form. Refresh the page before saving; your changes were not overwritten."
msgstr "Plik zmienił się po otwarciu formularza. Odśwież stronę przed zapisem; Twoje zmiany nie zostały nadpisane."
msgid "Too many sessions. Try again later."
msgstr "Zbyt wiele sesji. Spróbuj później."
msgid "Too many login attempts. Try again in 10 minutes."
msgstr "Zbyt wiele prób logowania. Spróbuj za 10 minut."
msgid "Invalid login or password."
msgstr "Nieprawidłowy login lub hasło."
msgid "Permission denied."
msgstr "Brak uprawnień."
msgid "The passwords do not match."
msgstr "Podane hasła nie są identyczne."
msgid "The password must be between 8 and 1024 characters long."
msgstr "Hasło musi mieć od 8 do 1024 znaków."
msgid "The account already exists."
msgstr "Konto już istnieje."
msgid "Account not found."
msgstr "Nie znaleziono konta."
msgid "The account limit has been reached."
msgstr "Osiągnięto limit kont."
msgid "The primary administrator cannot be deleted."
msgstr "Nie można usunąć głównego administratora."
msgid "The page could not be loaded. Try again later."
msgstr "Nie udało się załadować strony. Spróbuj ponownie później."
msgid "Invalid request."
msgstr "Nieprawidłowe żądanie."
msgid "version {version}"
msgstr "wersja {version}"
msgid "Open navigation"
msgstr "Otwórz nawigację"
msgid "Close navigation"
msgstr "Zamknij nawigację"
msgid "Expand: {title}"
msgstr "Rozwiń: {title}"
msgid "Collapse: {title}"
msgstr "Zwiń: {title}"
msgid "Main page"
msgstr "Strona główna"
msgid "Uploading…"
msgstr "Wysyłanie…"
msgid "Add photo"
msgstr "Dodaj zdjęcie"

msgid "Menu language version"
msgstr "Wersja językowa menu"

msgid "Menu"
msgstr "Menu"

msgid "Translate menu names without changing its shared structure or links."
msgstr "Tłumacz nazwy menu bez zmieniania jego wspólnego układu ani odnośników."

msgid "Save translations"
msgstr "Zapisz tłumaczenia"

msgid "Menu structure and links are shared by every language. Here you only translate the names shown to visitors."
msgstr "Układ menu i odnośniki są wspólne dla wszystkich języków. Tutaj tłumaczysz tylko nazwy widoczne dla odwiedzających."

msgid "Menu translations"
msgstr "Tłumaczenia menu"

msgid "Default name"
msgstr "Nazwa domyślna"

msgid "Translation"
msgstr "Tłumaczenie"

msgid "Add an item to the default-language menu before creating translations."
msgstr "Dodaj element do menu w języku domyślnym, zanim utworzysz tłumaczenia."

msgid "The default language menu is edited as a menu tree."
msgstr "Menu w języku domyślnym edytuje się jako drzewo."

msgid "The menu structure changed after opening the form. Refresh the page before saving."
msgstr "Układ menu zmienił się po otwarciu formularza. Odśwież stronę przed zapisaniem."

msgid "The translation file changed after opening the form. Refresh the page before saving."
msgstr "Plik tłumaczeń zmienił się po otwarciu formularza. Odśwież stronę przed zapisaniem."

msgid "Copy gallery from another language"
msgstr "Skopiuj galerię z innego języka"

msgid "Copy gallery from"
msgstr "Skopiuj galerię z"

msgid "Copy gallery"
msgstr "Skopiuj galerię"

msgid "Copying replaces this language version’s gallery. The image files are shared, not duplicated."
msgstr "Kopiowanie zastępuje galerię tej wersji językowej. Pliki zdjęć są współdzielone, a nie powielane."

msgid "Choose a different language as the gallery source."
msgstr "Wybierz inny język jako źródło galerii."

msgid "The selected language does not have its own gallery."
msgstr "Wybrany język nie ma własnej galerii."

msgid "The selected language gallery is empty."
msgstr "Galeria w wybranym języku jest pusta."

msgid "Site settings language version"
msgstr "Wersja językowa ustawień strony"

msgid "This language does not have its own site settings file yet. Translatable values currently fall back to the default language."
msgstr "Ten język nie ma jeszcze własnego pliku ustawień strony. Teksty korzystają obecnie z wartości języka domyślnego."

msgid "Only visitor-facing text can differ by language. Disabled settings always come from site.yml."
msgstr "W poszczególnych językach może różnić się tylko tekst widoczny dla odwiedzających. Wyłączone ustawienia zawsze pochodzą z site.yml."

msgid "The default language uses the main site settings file."
msgstr "Język domyślny korzysta z głównego pliku ustawień strony."

msgid "The localized site settings changed after opening the form. Refresh the page before saving."
msgstr "Ustawienia tej wersji językowej zmieniły się po otwarciu formularza. Odśwież stronę przed zapisaniem."
