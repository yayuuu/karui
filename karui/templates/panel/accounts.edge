<div class="panel-section-heading"><div><h2>{{ user.role === 'owner' ? t('Administrator accounts') : t('My account') }}</h2><p>{{ t('Changing a password ends all active sessions for that account.') }}</p></div></div>
@each(account in accounts)
  <details class="panel-section"><summary>{{ account.login }} <span>{{ account.role === 'owner' ? t('Owner') : t('Administrator') }}</span></summary>
    <form class="panel-form" data-account-form><input type="hidden" name="login" value="{{ account.login }}"><input type="hidden" name="create" value="false"><label>{{ t('New password') }}<input type="password" name="password" minlength="8" maxlength="1024" autocomplete="new-password" required></label><label>{{ t('Confirm password') }}<input type="password" name="confirmation" minlength="8" maxlength="1024" autocomplete="new-password" required></label><button class="primary" type="submit">{{ t('Change password') }}</button></form>
    @if(user.role === 'owner' && account.role !== 'owner')
      <button class="danger" type="button" data-delete-account="{{ account.login }}">{{ t('Delete account {login}', { login: account.login }) }}</button>
    @end
  </details>
@end
@if(user.role === 'owner')
  <details class="panel-section"><summary>＋ {{ t('Create account') }} <span>{{ t('New administrator') }}</span></summary><form class="panel-form" data-account-form><input type="hidden" name="create" value="true"><label>{{ t('Login') }}<input type="text" name="login" pattern="[A-Za-z0-9_-]{1,48}" autocomplete="off" required></label><label>{{ t('Password') }}<input type="password" name="password" minlength="8" maxlength="1024" autocomplete="new-password" required></label><label>{{ t('Confirm password') }}<input type="password" name="confirmation" minlength="8" maxlength="1024" autocomplete="new-password" required></label><button class="primary" type="submit">{{ t('Create account') }}</button></form></details>
@end
