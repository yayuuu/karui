{
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts", "../content/plugins", "../content/themes", "../content/tests", "../docs/plugins", "playwright.config.ts", "playwright.panel.config.ts"]
}
