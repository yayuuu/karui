CONTENT_PATH=./content
PORT=3000
BIND_ADDRESS=127.0.0.1
LOCAL_UID=1000
LOCAL_GID=1000
# true for HTTPS; false for local preview via HTTP
PANEL_SECURE_COOKIE=true
# Brotli/gzip for text responses. Set to false to disable compression.
HTTP_COMPRESSION=true
# Constant pool, maximum number of threads and TTL for additional workers after a request.
PLUGIN_WORKERS=8
PLUGIN_MAX_WORKERS=16
PLUGIN_WORKER_IDLE_MS=10000
PLUGIN_TIMEOUT_MS=5000
# Limits for each worker's V8 heap, in MB (not total process/container memory).
# Ranges: old 16–4096, young 4–1024, stack 1–64; only integer values.
PLUGIN_WORKER_OLD_GENERATION_MB=64
PLUGIN_WORKER_YOUNG_GENERATION_MB=16
PLUGIN_WORKER_STACK_MB=4
