CONTENT_PATH=./content
PORT=3000
BIND_ADDRESS=127.0.0.1
LOCAL_UID=1000
LOCAL_GID=1000
# true dla HTTPS; false tylko w lokalnym podglądzie przez HTTP
PANEL_SECURE_COOKIE=true
# Stała pula, maksymalna liczba wątków i TTL dodatkowych workerów po żądaniu.
PLUGIN_WORKERS=8
PLUGIN_MAX_WORKERS=16
PLUGIN_WORKER_IDLE_MS=10000
PLUGIN_TIMEOUT_MS=5000
# Limity V8 każdego workera, w MB (nie całkowita pamięć procesu/kontenera).
# Zakresy: old 16–4096, young 4–1024, stos 1–64; wyłącznie liczby całkowite.
PLUGIN_WORKER_OLD_GENERATION_MB=64
PLUGIN_WORKER_YOUNG_GENERATION_MB=16
PLUGIN_WORKER_STACK_MB=4
